generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AnalyzeJob {
  id         String   @id
  url        String
  status     String   @default("queued")
  progress   Int      @default(0)
  logsJson   String   @default("[]")
  reportJson String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
